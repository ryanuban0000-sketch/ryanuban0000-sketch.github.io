<script>
  const reveals = document.querySelectorAll('.reveal');
  const io = new IntersectionObserver((entries)=>{
    entries.forEach(e=>{
      if(e.isIntersecting){ e.target.classList.add('show'); }
    });
  }, { threshold: 0.12 });
  reveals.forEach(r=>io.observe(r));
</script>

