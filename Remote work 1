<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Ryan Pangilinan — Logistics Coordinator</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@600;700;800&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root{
    --navy: #12213D;
    --navy-deep: #0A1526;
    --amber: #E8A33D;
    --cream: #F7F5F0;
    --ink: #1C1F26;
    --muted: #6B7280;
    --line: #D8D3C7;
  }
  *{ margin:0; padding:0; box-sizing:border-box; }
  html{ scroll-behavior:smooth; }
  body{
    background:var(--cream);
    color:var(--ink);
    font-family:'Inter', sans-serif;
    line-height:1.6;
  }
  h1,h2,h3{
    font-family:'Big Shoulders Display', sans-serif;
    text-transform:uppercase;
    letter-spacing:0.01em;
  }
  .mono{ font-family:'JetBrains Mono', monospace; }
  a{ color:inherit; text-decoration:none; }

  /* ===== HEADER STRIP ===== */
  .topbar{
    background:var(--navy-deep);
    color:var(--cream);
    font-family:'JetBrains Mono', monospace;
    font-size:0.72rem;
    letter-spacing:0.08em;
    padding:9px 24px;
    display:flex;
    justify-content:space-between;
    flex-wrap:wrap;
    gap:6px;
    text-transform:uppercase;
  }
  .topbar span{ opacity:0.85; }
  .topbar b{ color:var(--amber); }

  /* ===== HERO / WAYBILL ===== */
  .hero{
    background:var(--navy);
    color:var(--cream);
    padding:64px 24px 0;
    position:relative;
    overflow:hidden;
  }
  .hero-inner{
    max-width:1000px;
    margin:0 auto;
  }
  .eyebrow{
    font-family:'JetBrains Mono', monospace;
    font-size:0.78rem;
    letter-spacing:0.18em;
    color:var(--amber);
    text-transform:uppercase;
    display:flex;
    align-items:center;
    gap:10px;
  }
  .eyebrow::before{
    content:"";
    width:28px;
    height:2px;
    background:var(--amber);
    display:inline-block;
  }
  .hero h1{
    font-size:clamp(3.2rem, 10vw, 6.5rem);
    font-weight:800;
    line-height:0.92;
    margin:18px 0 6px;
  }
  .hero .role{
    font-family:'JetBrains Mono', monospace;
    font-size:clamp(0.85rem, 2vw, 1.05rem);
    letter-spacing:0.12em;
    text-transform:uppercase;
    color:#C9D2E3;
    margin-bottom:34px;
  }
  .hero .role em{ color:var(--amber); font-style:normal; }

  /* manifest field strip */
  .manifest{
    background:var(--navy-deep);
    border:1px solid #24345A;
    border-radius:2px;
    display:grid;
    grid-template-columns:repeat(4, 1fr);
    margin-bottom:-1px;
  }
  .manifest .field{
    padding:16px 20px;
    border-right:1px solid #24345A;
  }
  .manifest .field:last-child{ border-right:none; }
  .manifest .field label{
    display:block;
    font-family:'JetBrains Mono', monospace;
    font-size:0.62rem;
    letter-spacing:0.12em;
    color:var(--amber);
    text-transform:uppercase;
    margin-bottom:6px;
  }
  .manifest .field a, .manifest .field span{
    font-size:0.88rem;
    color:var(--cream);
    word-break:break-word;
  }

  @media (max-width: 720px){
    .manifest{ grid-template-columns:repeat(2, 1fr); }
    .manifest .field:nth-child(2){ border-right:none; }
  }

  /* ===== SECTION SHELL ===== */
  section{
    max-width:1000px;
    margin:0 auto;
    padding:72px 24px;
  }
  .section-head{
    display:flex;
    align-items:baseline;
    gap:14px;
    margin-bottom:32px;
  }
  .section-head .tag{
    font-family:'JetBrains Mono', monospace;
    font-size:0.72rem;
    color:var(--muted);
    letter-spacing:0.1em;
  }
  .section-head h2{
    font-size:clamp(1.8rem, 4vw, 2.6rem);
    color:var(--navy);
  }
  .rule{
    height:1px;
    background:var(--line);
    flex:1;
    margin-top:6px;
  }

  /* ===== SUMMARY ===== */
  .summary-text{
    font-size:1.08rem;
    color:#3A3F4B;
    max-width:64ch;
  }

  /* ===== SERVICES ===== */
  .services-grid{
    display:grid;
    grid-template-columns:repeat(2, 1fr);
    gap:1px;
    background:var(--line);
    border:1px solid var(--line);
  }
  .service-card{
    background:var(--cream);
    padding:26px 24px;
  }
  .service-card .num{
    font-family:'JetBrains Mono', monospace;
    color:var(--amber);
    font-size:0.78rem;
    display:block;
    margin-bottom:8px;
  }
  .service-card h3{
    font-size:1.15rem;
    color:var(--navy);
    margin-bottom:6px;
    font-weight:700;
  }
  .service-card p{
    color:var(--muted);
    font-size:0.92rem;
  }
  @media (max-width:640px){ .services-grid{ grid-template-columns:1fr; } }

  /* ===== ROUTE / EXPERIENCE ===== */
  .route-wrap{ position:relative; padding-top:10px; }
  .route-line{
    position:absolute;
    left:11px;
    top:8px;
    bottom:8px;
    width:2px;
    background:repeating-linear-gradient(to bottom, var(--amber) 0 6px, transparent 6px 12px);
  }
  .stop{
    position:relative;
    padding-left:44px;
    margin-bottom:40px;
  }
  .stop:last-child{ margin-bottom:0; }
  .stop::before{
    content:"";
    position:absolute;
    left:2px;
    top:4px;
    width:20px;
    height:20px;
    border-radius:50%;
    background:var(--navy);
    border:3px solid var(--amber);
  }
  .stop .leg{
    font-family:'JetBrains Mono', monospace;
    font-size:0.72rem;
    letter-spacing:0.08em;
    color:var(--amber);
    text-transform:uppercase;
    background:var(--navy);
    display:inline-block;
    padding:3px 9px;
    border-radius:2px;
    margin-bottom:8px;
  }
  .stop h3{
    font-size:1.4rem;
    color:var(--navy);
    margin-bottom:4px;
  }
  .stop .role-line{
    color:var(--muted);
    font-size:0.92rem;
    font-style:normal;
  }

  /* ===== STRENGTHS + EDUCATION (side by side) ===== */
  .two-col{
    display:grid;
    grid-template-columns:1.1fr 0.9fr;
    gap:48px;
  }
  @media (max-width:760px){ .two-col{ grid-template-columns:1fr; } }
  .strength-list{ list-style:none; }
  .strength-list li{
    padding:14px 0;
    border-bottom:1px solid var(--line);
    display:flex;
    gap:14px;
    align-items:flex-start;
  }
  .strength-list li:first-child{ padding-top:0; }
  .strength-list .mark{
    color:var(--amber);
    font-family:'JetBrains Mono', monospace;
    font-weight:700;
  }
  .edu-item{ margin-bottom:22px; }
  .edu-item:last-child{ margin-bottom:0; }
  .edu-item .yr{
    font-family:'JetBrains Mono', monospace;
    font-size:0.75rem;
    color:var(--amber);
    display:block;
    margin-bottom:4px;
  }
  .edu-item h4{
    font-family:'Big Shoulders Display', sans-serif;
    text-transform:uppercase;
    font-size:1.15rem;
    color:var(--navy);
  }
  .edu-item span.school{
    color:var(--muted);
    font-size:0.9rem;
  }

  /* ===== CONTACT / FOOTER ===== */
  .contact-block{
    background:var(--navy);
    color:var(--cream);
    padding:72px 24px;
    text-align:center;
  }
  .contact-block .eyebrow{ justify-content:center; }
  .contact-block .eyebrow::before{ display:none; }
  .contact-block h2{
    font-size:clamp(2.2rem, 6vw, 3.6rem);
    margin:14px 0 24px;
  }
  .contact-links{
    display:flex;
    justify-content:center;
    gap:16px;
    flex-wrap:wrap;
    margin-top:8px;
  }
  .contact-links a{
    font-family:'JetBrains Mono', monospace;
    font-size:0.85rem;
    letter-spacing:0.05em;
    border:1px solid #33436A;
    padding:12px 22px;
    border-radius:2px;
    transition:0.2s;
  }
  .contact-links a:hover{
    background:var(--amber);
    color:var(--navy-deep);
    border-color:var(--amber);
  }
  footer{
    text-align:center;
    padding:18px;
    font-family:'JetBrains Mono', monospace;
    font-size:0.68rem;
    color:var(--muted);
    background:var(--navy-deep);
  }

  /* reveal on scroll */
  .reveal{ opacity:0; transform:translateY(16px); transition:opacity 0.6s ease, transform 0.6s ease; }
  .reveal.show{ opacity:1; transform:translateY(0); }

  @media (prefers-reduced-motion: reduce){
    .reveal{ opacity:1; transform:none; transition:none; }
    html{ scroll-behavior:auto; }
  }

  :focus-visible{
    outline:2px solid var(--amber);
    outline-offset:3px;
  }
</style>
</head>
